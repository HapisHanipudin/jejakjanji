# Port host untuk Postgres dari docker-compose.yml. Ganti bila 5432 sudah terpakai (sesuaikan juga URL di bawah).
POSTGRES_PORT=5432

# Postgres lokal (sesuai docker-compose.yml). Dipakai drizzle-kit dan scripts/seed.ts.
DATABASE_URL=postgres://jejakjanji:jejakjanji@localhost:5432/jejakjanji

# Dipakai `wrangler dev` untuk binding Hyperdrive lokal (lihat docs/DECISIONS.md).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://jejakjanji:jejakjanji@localhost:5432/jejakjanji

# Dipakai apps/web (server saja) untuk membaca apps/api. Sesuaikan port bila `bun run dev --port ...`.
API_BASE_URL=http://127.0.0.1:8787
